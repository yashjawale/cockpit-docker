# Create a GitHub upstream release. Replace "TARNAME" with your project tarball
# name and enable this by dropping the ".disabled" suffix from the file name.
# See README.md.
#
# Release artifacts (source tarball, Debian package) are GPG-signed when the
# GPG_PRIVATE_KEY and GPG_PASSPHRASE secrets are configured; see
# tools/sign-release.sh and the README for how to set this up.
name: release
on:
  push:
    tags:
      # this is a glob, not a regexp
      - '[0-9]*'
jobs:
  source:
    runs-on: ubuntu-latest
    container:
      image: ghcr.io/cockpit-project/tasks:latest
      options: --user root
    permissions:
      # create GitHub release
      contents: write
    env:
      GH_TOKEN: ${{ github.token }}
    steps:
      - name: Clone repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Install gh
        run: dnf install -y gh gnupg2

      # https://github.blog/2022-04-12-git-security-vulnerability-announced/
      - name: Pacify git's permission check
        run: git config --global --add safe.directory /__w/

      - name: Workaround for https://github.com/actions/checkout/pull/697
        run: |
          TAG_VERSION="$(git describe --tags)"
          git fetch --force origin ${TAG_VERSION}:refs/tags/${TAG_VERSION}

      - name: Build release
        run: make dist

      - name: Sign the release tarball
        if: ${{ secrets.GPG_PRIVATE_KEY != '' }}
        env:
          GPG_KEY: ${{ secrets.GPG_PRIVATE_KEY }}
          GPG_PASSPHRASE: ${{ secrets.GPG_PASSPHRASE }}
        run: |
          TAG_VERSION="$(git describe --tags)"
          REPO_NAME="${GITHUB_REPOSITORY#*/}"
          tools/sign-release.sh ${REPO_NAME}-${TAG_VERSION}.tar.xz

      - name: Create a release
        run: |
          set -x

          TAG_VERSION="$(git describe --tags)"
          git tag -l --format='%(contents:body)' ${TAG_VERSION} > release-note.txt

          REPO_NAME="${GITHUB_REPOSITORY#*/}"
          gh release create --title ${TAG_VERSION} --notes-file release-note.txt  \
            ${TAG_VERSION} \
            ${REPO_NAME}-${TAG_VERSION}.tar.xz

      - name: Upload signature and public key
        if: ${{ secrets.GPG_PRIVATE_KEY != '' }}
        run: |
          TAG_VERSION="$(git describe --tags)"
          REPO_NAME="${GITHUB_REPOSITORY#*/}"
          gh release upload ${TAG_VERSION} \
            ${REPO_NAME}-${TAG_VERSION}.tar.xz.asc KEYS --clobber

  # Build a Debian binary package from the release tarball and attach it to the
  # same release. The tarball ships the pre-built dist/ bundle and the debian/
  # directory, so this job needs no node toolchain.
  debian:
    runs-on: ubuntu-latest
    needs: source
    permissions:
      # upload the package to the release
      contents: write
    env:
      GH_TOKEN: ${{ github.token }}
    steps:
      - name: Clone repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Install build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y debhelper gettext dpkg-dev xz-utils

      # https://github.blog/2022-04-12-git-security-vulnerability-announced/
      - name: Pacify git's permission check
        run: git config --global --add safe.directory /__w/

      - name: Workaround for https://github.com/actions/checkout/pull/697
        run: |
          TAG_VERSION="$(git describe --tags)"
          git fetch --force origin ${TAG_VERSION}:refs/tags/${TAG_VERSION}

      - name: Download release tarball
        run: |
          TAG_VERSION="$(git describe --tags)"
          gh release download "${TAG_VERSION}" --pattern '*.tar.xz'

      - name: Build Debian package
        run: |
          tar -xf cockpit-docker-*.tar.xz
          cd cockpit-docker-*
          dpkg-buildpackage -b -us -uc

      - name: Sign the Debian package
        if: ${{ secrets.GPG_PRIVATE_KEY != '' }}
        env:
          GPG_KEY: ${{ secrets.GPG_PRIVATE_KEY }}
          GPG_PASSPHRASE: ${{ secrets.GPG_PASSPHRASE }}
        run: tools/sign-release.sh ./*.deb

      - name: Attach package to the release
        run: |
          TAG_VERSION="$(git describe --tags)"
          gh release upload "${TAG_VERSION}" ./*.deb --clobber

      - name: Upload signature
        if: ${{ secrets.GPG_PRIVATE_KEY != '' }}
        run: |
          TAG_VERSION="$(git describe --tags)"
          gh release upload "${TAG_VERSION}" ./*.deb.asc --clobber
