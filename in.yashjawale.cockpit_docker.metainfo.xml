<?xml version="1.0" encoding="UTF-8"?>
<component type="addon">
  <id>in.yashjawale.cockpit_docker</id>
  <metadata_license>CC0-1.0</metadata_license>
  <name>Cockpit Docker</name>
  <summary>Manage Docker containers and images</summary>
  <description>
    <p>
      A simple Cockpit module for managing Docker containers and images.
    </p>
    <p>
      You can start, stop, remove and inspect containers, run and search
      images, create and manage stacks, and more.
    </p>
  </description>
  <extends>org.cockpit_project.cockpit</extends>
  <launchable type="cockpit-manifest">cockpit-docker</launchable>
  <url type="homepage">https://github.com/yashjawale/cockpit-docker</url>
  <url type="bugtracker">https://github.com/yashjawale/cockpit-docker/issues</url>
  <update_contact>yash25.j@gmail.com</update_contact>
  <developer id="in.yashjawale">
    <name>Yash Jawale</name>
  </developer>
</component>
