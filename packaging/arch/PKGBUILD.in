pkgname=cockpit-docker
pkgver=VERSION
pkgrel=1
pkgdesc='Cockpit plugin for managing Docker'
arch=('x86_64')
url='https://github.com/yashjawale/cockpit-docker'
license=(LGPL)
source=("SOURCE")
sha256sums=('SKIP')

package() {
  depends=(cockpit)
  cd $pkgname
  make DESTDIR="$pkgdir" install PREFIX=/usr
}
