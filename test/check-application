#!/usr/bin/python3 -cimport os, sys; os.execv(os.path.dirname(sys.argv[1]) + "/common/pywrap", sys.argv)

# Run this with --help to see available options for tracing and debugging
# See https://github.com/cockpit-project/cockpit/blob/main/test/common/testlib.py
# "class Browser" and "class MachineCase" for the available API.

import testlib


# Nondestructive tests all run in the same running VM. This allows them to run in Packit, Fedora, and
# RHEL dist-git gating. They must not permanently change any file or configuration on the system in a
# way that influences other tests.
@testlib.nondestructive
class TestApplication(testlib.MachineCase):
    def testBasic(self):
        b = self.browser

        self.login_and_go("/cockpit-docker")

        # both main listing cards are shown
        b.wait_in_text("#containers-containers .pf-v6-c-card__title", "Containers")
        b.wait_in_text("#containers-images .pf-v6-c-card__title", "Images")

        # no containers have been created yet
        b.wait_in_text("#containers-containers .pf-v6-c-empty-state", "No containers")

        # the image listing is collapsed by default; expand it
        b.click("#containers-images .pf-v6-c-expandable-section__toggle button")
        # the busybox image is pre-pulled into the test VM
        b.wait_in_text("#containers-images .image-name", "busybox")

    def testContainers(self):
        b = self.browser
        m = self.machine

        self.login_and_go("/cockpit-docker")
        b.click("#containers-images .pf-v6-c-expandable-section__toggle button")
        b.wait_in_text("#containers-images .image-name", "busybox")

        try:
            # start a container on the machine; it should show up in the UI
            m.execute("docker run -d --name test-cockpit-docker busybox sleep 10000")
            b.reload()
            b.enter_page("/cockpit-docker")
            b.wait_in_text(".container-name", "test-cockpit-docker")
            b.wait_visible("tr[data-row-name='0-test-cockpit-docker']")
        finally:
            # clean up so the shared machine stays in a pristine state
            m.execute("docker rm -f test-cockpit-docker")
            b.reload()
            b.enter_page("/cockpit-docker")
            b.wait_not_present(".container-name")


# This test gets its own fresh VM (not @nondestructive) because it makes
# permanent changes: it hides the docker CLI and stops the docker daemon.
class TestDockerNotInstalled(testlib.MachineCase):
    def testDockerNotInstalled(self):
        b = self.browser
        m = self.machine

        # simulate a system without docker: no daemon and no docker CLI
        m.execute("systemctl mask docker docker.socket")
        m.execute("systemctl stop docker docker.socket")
        m.execute("mv /usr/bin/docker /usr/bin/docker.example")

        self.login_and_go("/cockpit-docker")

        b.wait_in_text(".pf-v6-c-empty-state__title", "Docker is not installed")
        b.wait_in_text(".pf-v6-c-empty-state__body", "Docker is not installed on this system.")
        b.wait_in_text(".pf-v6-c-empty-state__body", "See Docker installation instructions")


if __name__ == '__main__':
    testlib.test_main()
