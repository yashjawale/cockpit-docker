    def testStackLifecycle(self):
        b = self.browser
        m = self.machine

        # create the stack's compose files under the plugin's stack directory
        m.execute('''mkdir -p /var/lib/cockpit-docker/stacks/test-stack
cat > /var/lib/cockpit-docker/stacks/test-stack/docker-compose.yml <<'EOF'
services:
  web:
    image: busybox
    command: ["sleep", "3600"]
EOF''')

        self.login_and_go("/cockpit-docker")
        b.reload()
        b.enter_page("/cockpit-docker")
        try:
            # the not-yet-started stack is listed under inactive stacks
            b.wait_in_text(".container-inactive-stacks", "test-stack")
            b.wait_visible("tr[data-row-name='test-stack']")

            # its edit dialog is prefilled with the stack name
            b.click("#inactive-stack-actions-test-stack")
            b.click(".pf-v6-c-menu__item:contains('Edit')")
            b.wait_visible(".pf-v6-c-modal-box")
            b.wait_text(".pf-v6-c-modal-box__title", "Edit stack test-stack")
            b.click(".btn-cancel")
