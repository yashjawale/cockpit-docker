    def testContainerStopStartRestart(self):
        b = self.browser
        m = self.machine

        self.login_and_go("/cockpit-docker")
        try:
            m.execute("docker run -d --name test-restart busybox sleep 10000")
            b.reload()
            b.enter_page("/cockpit-docker")
            row = "#containers-containers tr[data-row-name='0-test-restart']"
            b.wait_in_text(row, "Running")

            # stop the container from the row kebab menu
            b.click(row + " .pf-v6-c-menu-toggle")
            b.click(".pf-v6-c-menu__item:contains('Stop')")
            b.wait_in_text(row, "Exited")

            # start it again
            b.click(row + " .pf-v6-c-menu-toggle")
            b.click(".pf-v6-c-menu__item:contains('Start')")
            b.wait_in_text(row, "Running")

            # and restart it
            b.click(row + " .pf-v6-c-menu-toggle")
            b.click(".pf-v6-c-menu__item:contains('Restart')")
            b.wait_in_text(row, "Running")

            # force restart and force stop use a zero timeout
            b.click(row + " .pf-v6-c-menu-toggle")
            b.click(".pf-v6-c-menu__item:contains('Force restart')")
            b.wait_in_text(row, "Running")

            b.click(row + " .pf-v6-c-menu-toggle")
            b.click(".pf-v6-c-menu__item:contains('Force stop')")
            b.wait_in_text(row, "Exited")

            # start it again so the cleanup removes a running container
            b.click(row + " .pf-v6-c-menu-toggle")
            b.click(".pf-v6-c-menu__item:contains('Start')")
            b.wait_in_text(row, "Running")
        finally:
            m.execute("docker rm -f test-restart")
            b.reload()
            b.enter_page("/cockpit-docker")
            b.wait_not_present(".container-name")

