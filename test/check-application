    def testRemoveInactiveStack(self):
        b = self.browser
        m = self.machine

        self.login_and_go("/cockpit-docker")
        try:
            # create an inactive stack on disk, so it shows up in the listing
            m.execute('''mkdir -p /var/lib/cockpit-docker/stacks/test-remove-stack
cat > /var/lib/cockpit-docker/stacks/test-remove-stack/docker-compose.yml <<'EOF'
