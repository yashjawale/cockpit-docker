# This test gets its own fresh VM (not @nondestructive) because it makes
# permanent changes: it hides the docker CLI and stops the docker daemon.
class TestDockerNotInstalled(testlib.MachineCase):
    def testDockerNotInstalled(self):
        b = self.browser
        m = self.machine

        # simulate a system without docker: no daemon and no docker CLI
        m.execute("systemctl mask docker docker.socket")
        m.execute("systemctl stop docker docker.socket")
        m.execute("mv /usr/bin/docker /usr/bin/docker.example")

        self.login_and_go("/cockpit-docker")

        b.wait_in_text(".pf-v6-c-empty-state__title", "Docker is not installed")
        b.wait_in_text(".pf-v6-c-empty-state__body", "Docker is not installed on this system.")
        b.wait_in_text(".pf-v6-c-empty-state__body", "See Docker installation instructions")


